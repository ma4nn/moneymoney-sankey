{
  "compilerOptions": {
    "strict": true,
    // CSS imports are resolved and bundled by esbuild, not by tsc (TS >= 6 would reject them as TS2882)
    "noUncheckedSideEffectImports": false,
    "outDir": "./dist",
    "allowJs": true,
    "target": "es2017",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true
  },
  "include": ["./src/**/*"]
}